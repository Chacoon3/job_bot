PROJECT_ID=your-project-id
APP_ENV=local
BROWSER_AUTOMATION_ENABLED=true
APPLICATION_ATTEMPT_LEASE_SECONDS=3600
LOG_LEVEL=INFO
REGION=us-central1
REPOSITORY=job-bot-repo
IMAGE=job-bot
DATABASE_URL=postgresql+psycopg://job_bot:password@localhost:5432/job_bot
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
# OpenTelemetry is enabled when this endpoint is set. The HTTP/protobuf exporter
# appends /v1/traces and /v1/metrics to this base URL.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=job-bot
