{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug FastAPI",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/src/job_bot/main.py",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Debug greenhouse CLI",
      "type": "python",
      "request": "launch",
      "module": "job_bot.greenhouse.cli",
      "args": [
        "--limit", "10",
        "--max-candidates", "1000",
        "--crawl-count", "1",
        "--max-pages-per-query", "10"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true
    },

  ]
}
